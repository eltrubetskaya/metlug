 <div class="comments-list">
        {% for comment in comments %}
        <div class="media">
            <div class="media-body text-left">
                <h4 class="media-heading user_name"><img width="40px" src="{{ asset('build/img/culbaba.png') }}" alt=""> {{ comment.user }}</h4>
                {{ comment.text }}
            </div>
            <div class="text-right"><p><small>{{ comment.createdAt|date('Y-m-d H:i') }}</small></p></div>
        </div>
        {% endfor %}
    </div>
