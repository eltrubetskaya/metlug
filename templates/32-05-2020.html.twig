{% extends 'base.html.twig' %}

{% block title %}{% endblock %}

    {% block stylesheets %}
        <link href="{{ asset('build/css/all.css') }}" rel="stylesheet" type="text/css" />
        <link href="{{ asset('build/css/bootstrap.min.css') }}" rel="stylesheet" type="text/css" />
        <link href="{{ asset('build/css/32-05-2020.css') }}" rel="stylesheet" type="text/css" />
    {% endblock %}

{% block body %}
    <div id="icon-plus" data-toggle="modal" data-target="#commandModal">
        <i class="fas fa-plus fa-2x"></i>
    </div>
    <div class="container-fluid">
        <div class="row">

        </div>
    </div>
    <!-- Modal -->
    <div class="modal fade" id="commandModal" tabindex="-1" role="dialog" aria-labelledby="commandModalTitle" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered" role="document">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title" id="exampleModalLongTitle">Modal title</h5>
                    <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                        <span aria-hidden="true">&times;</span>
                    </button>
                </div>
                <div class="modal-body">

                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-dismiss="modal">Close</button>
                    <button type="button" class="btn btn-info">Save changes</button>
                </div>
            </div>
        </div>
    </div>
{% endblock body %}

{% block javascripts %}
    {{ parent() }}

    <script>

    </script>
{% endblock %}
