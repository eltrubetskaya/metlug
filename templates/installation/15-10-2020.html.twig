{% extends 'layout.html.twig' %}
{% block title %}Фридрих Ницше{% endblock %}
{% block stylesheets %}
    {{ parent() }}
{% endblock %}

{% block menu %}
    <!-- Navigation -->
    <nav class="navbar navbar-expand-lg navbar-dark fixed-top" id="mainNav">
        <div class="container-fluid">
            <div class="col-1 d-none d-sm-none d-md-block">

            </div>
            <div class="col-md-10 col-12 pl-0">
                <a class="navbar-brand js-scroll-trigger" href="{{ path('homepage') }}">The «METLUG» Theatre - means we're from Lugansk City</a>
            </div>
            <div class="col-1 d-none d-sm-none d-md-block">

            </div>
        </div>
    </nav>
{% endblock %}

{% block content %}
    <div class="container" style="margin-top: 100px">
        <div class="row">
            <div class="col-12 text-center">
                <img src="{{ asset('src/img/nizshe.jpeg') }}" alt="">
                <h3>Фридрих Ницше</h3>
                <p>15.10.1844-25.08.1900</p>
            </div>
        </div>
    </div>

{% endblock %}

{% block javascripts %}
    {{ parent() }}
    <script>
        {% if modalShow is defined and modalShow is not null %}
        $('#commandModal').modal('show')
        {% endif %}
    </script>
{% endblock %}
