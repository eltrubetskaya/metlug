<section class="container-fluid">
    <div class="row">
        <div class="col-lg-12 text-center">
            <div id="green">
                <div data-depth="0.2" id="tree"><a href="#" class="md-trigger" data-modal="modal-8"> <img src="{{ asset('src/img/lamp.png') }}" alt=""></a></div>
{#                <div data-depth="0.6" id="text"><h1>Сочельник у МЭТЁлки 2021-2022!</h1></div>#}
            </div>
        </div>
