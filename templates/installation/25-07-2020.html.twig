{% extends 'layout.html.twig' %}
{% block title %}Высоцкий В.С.{% endblock %}
{% block stylesheets %}
    {{ parent() }}
    <link href="{{ asset('build/css/32-05-2020.css') }}" rel="stylesheet" type="text/css" />
    <link href="{{ asset('build/css/25-07-2020.css') }}" rel="stylesheet" type="text/css" />
    <link href="{{ asset('build/css/slick.css') }}" rel="stylesheet" type="text/css" />
    <link href="{{ asset('build/css/slick-theme.css') }}" rel="stylesheet" type="text/css" />
{% endblock %}

{% block content %}
    <img src="{{ asset('src/img/6.png') }}" id="bg" alt="">
    <div id="icon-plus" data-toggle="modal" data-target="#commandModal" title="Добавить комментарий">
        <i class="fas fa-plus fa-2x"></i>
    </div>
    <div id="icon-sound" class="d-none">
        <i class="fas fa-volume-up"></i>
    </div>
    <!-- Header -->
    <header class="masthead">
        <div class="container">
            <div class="row">
                <div class="col-sm-12 col-xs-12 cover">
                    <img width="100%" src="{{ asset('src/img/7_2.jpg') }}" alt="">
                </div>
            </div>
            <div class="row">
                <div class="col-md-6"></div>
                <div class="col-md-6 col-sm-12 col-xs-12 title text-muted ">
                    <h1 class="masthead-heading text-uppercase">25 июля - день памяти Владимира Высоцкого. <br>
                        " Вспоминая, поминая, читая, почитая..."</h1>
                    <br>
                    <h4 class="masthead-subheading">" Мне скулы от досады сводит: <br>
                        Мне кажется который год, <br>
                        Что там, где я - там жизнь проходит, <br>
                        А там, где нет меня - идёт".</h4>
                </div>
            </div>
        </div>
    </header>

<section class="page-section" id="about">
    <div class="container">
        <div class="row">
            <div class="col-md-6 col-sm-12 col-xs-12" style="z-index: 200;opacity: 0.85;">
                <div id="carouselIndicators" class="carousel slide" data-ride="carousel">
                    <ol class="carousel-indicators">
                        <li data-target="#carouselIndicators" data-slide-to="0" class="active"></li>
                        <li data-target="#carouselIndicators" data-slide-to="1" class=""></li>
                        <li data-target="#carouselIndicators" data-slide-to="2" class=""></li>
                        <li data-target="#carouselIndicators" data-slide-to="3" class=""></li>
                        <li data-target="#carouselIndicators" data-slide-to="4" class=""></li>
                    </ol>
                    <div class="carousel-inner" style="border-radius: 10px;">
                        <div class="carousel-item active">
                            <img class="d-block w-100" data-src="{{ asset('src/img/v_6.jpg') }}" alt="First slide" src="{{ asset('src/img/v_6.jpg') }}" data-holder-rendered="true">
                        </div>
                        <div class="carousel-item">
                            <img class="d-block w-100" data-src="{{ asset('src/img/v_5.jpg') }}" alt="Second slide" src="{{ asset('src/img/v_5.jpg') }}" data-holder-rendered="true">
                        </div>
                        <div class="carousel-item">
                            <img class="d-block w-100" data-src="{{ asset('src/img/v_4.jpg') }}" alt="Second slide" src="{{ asset('src/img/v_4.jpg') }}" data-holder-rendered="true">
                        </div>
                        <div class="carousel-item">
                            <img class="d-block w-100" data-src="{{ asset('src/img/v_3.jpg') }}" alt="Second slide" src="{{ asset('src/img/v_3.jpg') }}" data-holder-rendered="true">
                        </div>
                        <div class="carousel-item">
                            <img class="d-block w-100" data-src="{{ asset('src/img/v_2.jpg') }}" alt="Second slide" src="{{ asset('src/img/v_2.jpg') }}" data-holder-rendered="true">
                        </div>
                    </div>
                    <a class="carousel-control-prev" href="#carouselIndicators" role="button" data-slide="prev">
                        <span class="carousel-control-prev-icon" aria-hidden="true"></span>
                        <span class="sr-only">Previous</span>
                    </a>
                    <a class="carousel-control-next" href="#carouselIndicators" role="button" data-slide="next">
                        <span class="carousel-control-next-icon" aria-hidden="true"></span>
                        <span class="sr-only">Next</span>
                    </a>
                </div>
            </div>
            <div class="col-md-6 col-sm-12 title">
                <h4 class="section-subheading text-muted">40 лет жизнь идёт (проходит?) без Него... И все же с Ним! Истина не нова - как " не горят рукописи", так и таланты не умирают. Всё Его осталось с Ним и с нами. И не только каждые полгода (25 января и 25 июля), а, практически, каждый день можно услышать его тексты, песни, которые давно уже прижились в народе, разобранные на цитаты. А вот сегодня, 25 июля 2020 года, уважая все грани и стороны проявления таланта Великого Гения, театр МЭТЛУГ предлагает сконцентрироваться на лирике. На том, что оголяет душу и делает беззащитным, при этом даёт крылья, поднимая ввысь... Здесь, в лирике Высоцкого, столько неожиданных открытий в простоте и красоте признаний, что до Него поэты даже и не знали, что так можно писать...!</h4>
            </div>
        </div>
        <div class="embed-responsive embed-responsive-16by9" style="z-index: 200; margin-top: 40px">
            <iframe class="embed-responsive-item" src="https://www.youtube-nocookie.com/embed/I4CgN9IR290?showinfo=1&modestbranding=1&rel=0&fs=1&iv_load_policy=3" frameborder="0" allow="accelerometer; encrypted-media; gyroscope; picture-in-picture" allowfullscreen></iframe>
        </div>

        <div class="col-md-12 col-sm-12 title" style="margin-top: 40px">
            <h4 class="section-subheading text-muted text-left">А теперь и ты, наш драгоценный зритель, скажи откровенно нам, Ему и всему миру, что СЕГОДНЯ тебе отозвалось, что " торкнуло" в самое сердце, что СЕГОДНЯ сделает твой день из черно-белого цветным. Жми на
                <a href="#"><i class="fas fa-plus"></i></a>, откройся Вселенной вместе с лирикой Владимира Высоцкого!</h4>
        </div>
        <div class="col-md-12 col-sm-12" style="margin-top: 40px;z-index: 200; padding: 0;">
            <div class="comments-list" style="display: flex;justify-content: space-between;margin-left: -15px;margin-right: -15px;    flex-direction: row;
    flex-wrap: wrap;">
                {% for comment in comments %}
                    {% if comment.user %}
                        {% set avatar = comment.user.avatar %}
                        {% set user = comment.user %}
                    {% else %}
                        {% set avatar = asset('src/img/logo.jpg') %}
                        {% set user = comment.username %}
                    {% endif %}
                    <div class="col-md-4 col-sm-12 col-xs-12">
                        <div class="media">
                            <div class="media-body text-left">
                                <h4 class="media-heading user_name"><img width="40px" class="rounded-circle" src="{{ avatar }}" alt=""> {{ user }}</h4>
                                {{ comment.text|raw }}
                                {% if comment.type == 'audio' %}
                                    <audio  controlsList="nodownload" controls style="z-index: 150;width: 100%">
                                        <source src="{{ comment.mediaLink }}" type="audio/mpeg">
                                        Your browser does not support the audio element.
                                    </audio>
                                {% endif %}
                                {% if comment.type == 'video' %}
                                    <div class="embed-responsive embed-responsive-16by9">
                                        <iframe class="embed-responsive-item" src="https://www.youtube-nocookie.com/embed/{{ comment.mediaLink }}?showinfo=1&modestbranding=1&rel=0&fs=1&iv_load_policy=3" frameborder="0" allow="accelerometer; encrypted-media; gyroscope; picture-in-picture" allowfullscreen></iframe>
                                    </div>
                                {% endif %}
                            </div>
                            <div class="text-right">
                                <p><small>{{ comment.createdAt|date('Y-m-d H:i') }}</small></p>
                                {% if comment.installation.category is not null and comment.installation.category.title == '32-may'%}
                                    <div>
                                        <img width="40px" src="{{ asset('build/img/dandelion_PNG12853.png') }}" alt="">
                                    </div>
                                {% endif %}
                            </div>
                        </div>
                    </div>
                {% endfor %}
            </div>
        </div>
    </div>
</section>
    {{ render(controller('App\\Controller\\CommentController::create', {'installationId': installation.id})) }}
    <div class="modal fade" id="l-25-07-20" tabindex="-1" role="dialog" aria-hidden="true">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="close-modal" data-dismiss="modal">
                    <div class="lr">
                        <div class="rl"></div>
                    </div>
                </div>
                <div class="modal-header text-left">
                    <h3>Владимир Высоцкий — <br><small>Я верю в нашу общую звезду:</small></h3>
                </div>
                <div class="modal-body text-left">
                    <p>Я верю в нашу общую звезду,<br>
                        Хотя давно за нею не следим мы, —<br>
                        Наш поезд с рельс сходил на всем ходу —<br>
                        Мы все же оставались невредимы.</p>

                    <p>Бил самосвал машину нашу в лоб,<br>
                        Но знали мы, что ищем и обрящем,<br>
                        И мы ни разу не сходили в гроб,<br>
                        Где нет надежды всем в него сходящим.</p>

                       <p> Катастрофы, паденья, — но между —<br>
                        Мы взлетали туда, где тепло,<br>
                        Просто ты не теряла надежду,<br>
                        Мне же — с верою очень везло.</p>

                        <p>Да и теперь, когда вдвоём летим,<br>
                        Пускай на ненадёжных самолётах, —<br>
                        Нам гасят свет и создают интим,<br>
                        Нам и мотор поёт на низких нотах.</p>

                        <p>Бывали «ТУ» и «ИЛы», «ЯКи», «АН», —<br>
                        Я верил, что в Париже, в Барнауле —<br>
                        Мы сядем, — если ж рухнем в океан —<br>
                        Двоих не съесть и голубой акуле!</p>

                        <p>Все мы смертны — и люди смеются:<br>
                        Не дождутся и вас города!<br>
                        Я же знал: все кругом разобьются,<br>
                        Мы ж с тобой — ни за что никогда!</p>

                        <p>Мне кажется такое по плечу —<br>
                        Что смертным не под силу столько прыти:<br>
                        Что на лету тебя я подхвачу —<br>
                        И вместе мы спланируем в Таити.</p>

                        <p>И если заболеет кто из нас<br>
                        Какой-нибудь болезнею смертельной —<br>
                        Она уйдёт, — хоть искрами из глаз,<br>
                        Хоть стонами и рвотою похмельной.

                        <p>Пусть в районе Мэзона-Лаффита<br>
                        Упадёт злополучный «Скайлаб»<br>
                        И судьба всех обманет — финита, —<br>
                        Нас она обмануть не смогла б!</p>
                </div>
                <div class="modal-footer text-center">
                    <button class="btn btn-primary" data-dismiss="modal" type="button">
                        <i class="fas fa-times"></i>
                        Close</button>
                </div>
            </div>
        </div>
    </div>
{% endblock %}

{% block javascripts %}
    {{ parent() }}
    <script src="{{ asset('build/js/slick.min.js') }}"></script>
{% endblock %}
