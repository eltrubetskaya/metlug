{% extends 'layout.html.twig' %}
{% block title %}{{ installation.description }}{% endblock %}
{% block stylesheets %}
    {{ parent() }}
    <link rel="image_src" href="{{ asset('build/img/logo_2.png') }}" />
    <link rel="stylesheet" href="{{ asset('build/css/15-10-2020.css') }}">
    <script type="text/javascript" src="{{ asset('src/media/j/lib/modernizr-1.7.min.js') }}" charset="utf-8"></script>
    <script type="text/javascript" src="{{ asset('src/media/j/lib/modernizr-positionfixed.js') }}" charset="utf-8"></script>

    <link href="{{ asset('src/media/c/lib/reset.css') }}" rel="stylesheet" type="text/css" media="screen,projection,print" />
    <link href="{{ asset('src/media/c/lib/text.css') }}" rel="stylesheet" type="text/css" media="screen,projection,print" />
    <link href="{{ asset('src/media/c/lib/defaults.css') }}" rel="stylesheet" type="text/css" media="screen,projection,print" />
    <link href="{{ asset('src/media/c/style.css') }}" rel="stylesheet" type="text/css" media="screen,projection,print" />
    <link href="{{ asset('src/media/c/site.css') }}" rel="stylesheet" type="text/css" media="screen,projection" />
    <link href="{{ asset('src/media/c/parts.css') }}" rel="stylesheet" type="text/css" media="screen,projection" />
{% endblock %}


{% block menu %}
    <!-- Navigation -->
    <nav class="navbar navbar-expand-lg navbar-dark pb-0" id="mainNav" style="padding-top: 0">
        <div class="container-fluid">
            <div class="col-1 d-none d-sm-none d-md-block">
                <a href="{{ path('installation_show', {title: '08-02-2021'}) }}" title="А он играл - не доиграл. Киноактёр Владимир Семёнович Высоцкий.">
                    <button class="toggle-i toggle i toggle-left">
                        <div class="cross">
                            <div class="x"></div>
                            <div class="y"></div>
                        </div>
                    </button>
                </a>
            </div>
            <div class="col-md-10 col-12 text-center">
                <a class="navbar-brand js-scroll-trigger" href="{{ path('homepage') }}">
                    <span class="notranslate" translate="no">{{ "The «METLUG» Theatre - means we're from Lugansk City"|raw }}</span>
                </a>
            </div>
            <div class="col-1 d-none d-sm-none d-md-block">
                <a href="{{ path('installation_show', {title: '32-05-2021'}) }}" title="32 Мая">
                    <button class="toggle-i toggle i toggle-left">
                        <div class="cross">
                            <div class="x"></div>
                            <div class="y"></div>
                        </div>
                    </button>
                </a>
            </div>
        </div>
    </nav>
{% endblock %}

{% block content %}
<div id="wrap" class="container-fluid">
    <hgroup id="header">
        <h1>МЭТЛУГ</h1>
        <h2 class="loading"></h2>
        <div class="content">
            <h2>
                Игра со случайными числами
            </h2>
        </div>
    </hgroup>

    <section id="parts">


        <img src="{{ asset('src/media/i/parts/Napoleon-Bonapart-3.jpg') }}" id="img-002_s1" alt="Nizo part 2" width="177" height="243">


        <img src="{{ asset('src/media/i/parts/g.jpg') }}" id="img-003_s1" alt="Nizo part 3" width="177" height="243">


        <img src="{{ asset('src/media/i/1.png') }}" id="img-004_s1" alt="Nizo part 4" width="200" height="80">


        <img src="{{ asset('src/media/i/3.png') }}" id="img-006B_s1" alt="Nizo part 7" width="220" height="100">

        <img src="{{ asset('src/media/i/5.png') }}" id="img-007-A-BELOW_s1" alt="Nizo part 10" width="400" height="56">


        <img src="{{ asset('src/media/i/4.png') }}" id="img-007_s1" alt="Nizo part 11" width="230" height="102">

        <img src="{{ asset('src/media/i/2.png') }}" id="img-009_s1" alt="Nizo part 13" width="240" height="90">

        <img src="{{ asset('src/media/i/6.png') }}" id="img-011_s1" alt="Nizo part 16" width="420" height="80">


        <img src="{{ asset('src/media/i/7.png') }}" id="img-012_s1" alt="Nizo part 17" width="389" height="78">

        <img src="{{ asset('src/media/i/parts/27.jpeg') }}" id="img-017b_s1" alt="Nizo part 25" width="200" height="240">

        <img src="{{ asset('src/media/i/parts/uilyam-shekspir.jpg') }}" id="img-020_s1" alt="Nizo part 27" width="190" height="260">

        <img src="{{ asset('src/media/i/8.png') }}" id="img-031_s1" alt="Nizo part 38" width="320" height="85">


        <img src="{{ asset('src/media/i/9.png') }}" id="img-032_s1" alt="Nizo part 39" width="441" height="100">

        <img src="{{ asset('src/media/i/10.png') }}" id="img-034_s1" alt="Nizo part 41" width="407" height="80">
    </section>

    <footer id="footer" class="clearfix">
        <div class="inner">
            <div class="form">
                <p style="font-size: 16px; font-weight: bold; color: #282624; position: absolute; right: 15px; bottom: -55px;">
                    "..One writ with me in sour misfortune's book!." <br> <br>
                    by William Shakespeare
                </p>
            </div>
        </div>
    </footer>
</div>

    <button style="position: fixed" id="toggle" class="toggle-i toggle i" data-toggle="modal" data-target="#commandModal" title="Добавить комментарий">
        <div class="cross">
            <div class="x"></div>
            <div class="y"></div>
        </div>
    </button>
    <!-- Modal -->
    <div class="modal fade" id="commandModal" tabindex="-1" role="dialog" aria-labelledby="commandModalTitle" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered" role="document">
            <div class="modal-content" style="text-shadow: none">
                <div class="modal-header text-muted text-left">
                    <p></p>
                </div>
                {% if app.user %}
                    {{ form_start(form) }}
                    <div class="modal-header text-muted">
                        <h5 class="modal-title" id="exampleModalLongTitle">{{ app.user }}</h5>
                    </div>
                    <div class="modal-body">
                        <div class="d-none">{{ form_row(form.username) }}</div>
                        {{ form_row(form.text) }}

                        <div class="d-none" style="font-size: 20px">{{ form_row(form.mediaLink) }}</div>
                        <div class="d-none">{{ form_row(form.type) }}</div>
                    </div>
                    <div class="modal-footer">
                        <div class="col-6 pr-0">

                        </div>
                        <div class="col-6 pl-0 pr-0">
                            <button type="submit" class="col-12 btn btn-secondary" style="height: auto">Оставить Комментарий</button>
                        </div>
                    </div>
                    {{ form_end(form) }}
                {% else %}
                    {{ form_start(form) }}
                    <div class="modal-body" >
                        {{ form_widget(form.username) }}
                        <hr>
                        <div class="">{{ form_row(form.text) }}</div>
                        <div class="custom-file d-none">
                            {{ form_row(form.mediaLink) }}
                        </div>
                        <div   class="d-none" style="font-size: 20px">{{ form_row(form.type) }}</div>
                    </div>
                    <div class="modal-footer">
                        <div class="col-6 pr-0">
                            <a class="btn btn-primary" href="{{ path('connect_google_start') }}"><i class="fab fa-google"></i><span style="margin-left: 15px;font-weight: bold;">Bойти в Google</span></a>
                        </div>
                        <div class="col-6 pl-0 pr-0">
                            <button type="submit" class="col-12 btn btn-secondary" style="height: auto">Оставить Комментарий</button>
                        </div>
                    </div>
                    {{ form_end(form) }}
                {% endif %}
                <div class="col-md-12 col-sm-12">
                    <div class="comments-list">
                        {% for comment in comments %}
                            {% if comment.user %}
                                {% set avatar = comment.user.avatar %}
                                {% set user = comment.user %}
                            {% else %}
                                {% set avatar = asset('src/img/logo.jpg') %}
                                {% set user = comment.username %}
                            {% endif %}
                            <div class="col-sm-12 text-muted">
                                <div class="media">
                                    <div class="media-body text-left">
                                        <h4 class="media-heading user_name"><img style="width: 40px" class="rounded-circle" src="{{ avatar }}" alt=""> {{ user }}</h4>
                                        {{ comment.text|raw }}
                                        {% if comment.type == 'video' %}
                                            <div class="embed-responsive embed-responsive-16by9">
                                                <iframe class="embed-responsive-item" src="{{ comment.mediaLink }}" frameborder="0" allow="accelerometer; encrypted-media; gyroscope; picture-in-picture" allowfullscreen></iframe>
                                            </div>
                                        {% endif %}
                                        {% if comment.type == 'audio' %}
                                            <audio  controlsList="nodownload" controls style="z-index: 150;width: 100%">
                                                <source src="{{ comment.mediaLink }}" type="audio/mpeg">
                                                Your browser does not support the audio element.
                                            </audio>
                                        {% endif %}
                                        {% if comment.type == 'image' and comment.mediaLink %}
                                            <div class="col-12" >
                                                <img width="300px" height="300px" src="{{ comment.mediaLink }}" alt="{{ installation.description }}">
                                            </div>
                                        {% endif %}
                                    </div>
                                    <div class="text-right">
                                        <p><small>{{ comment.createdAt|date('Y-m-d H:i') }}</small></p>
                                    </div>
                                </div>
                            </div>
                        {% endfor %}
                    </div>
                    <div class="modal-footer">
                        <div class="col-12 pr-0 text-center">
                            <a href="#" class="close" style="display: contents" data-dismiss="modal" aria-label="Close">
                                <i class="fa fa-times" style="color: red"></i>
                            </a>
                        </div>
                    </div>

                </div>
            </div>
        </div>
    </div>

{% endblock %}


{% block javascripts %}
    {{ parent() }}
    <script>
    {% if modalShow is defined and modalShow is not null %}
        $('#commandModal').modal('show')
    {% endif %}
    </script>
<script type="text/javascript" src="{{ asset('src/media/j/lib/jquery-1.6.1.min.js') }}"></script>
<script type="text/javascript" src="{{ asset('src/media/j/lib/jquery.placeholder.js') }}"></script>
<script type="text/javascript" src="{{ asset('src/media/j/lib/jquery-ui-1.8.11.custom.min.js') }}"></script>

<script type="text/javascript" src="{{ asset('src/media/j/behaviour.js') }}" charset="utf-8"></script>
<script type="text/javascript" src="{{ asset('src/media/j/site.js') }}" charset="utf-8"></script>

{% endblock %}
