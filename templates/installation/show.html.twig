            </tr>
        </tbody>
    </table>

    <a href="{{ path('installation_index') }}">back to list</a>

    <a href="{{ path('installation_edit', {'id': installation.id}) }}">edit</a>

    {{ include('installation/_delete_form.html.twig') }}
{% endblock %}
