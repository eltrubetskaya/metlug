{% extends 'layout.html.twig' %}
{% block title %}ЮНЫЙ БАРАБАНЩИК{% endblock %}
{% block stylesheets %}
    {{ parent() }}
    <link href="{{ asset('build/css/32-05-2020.css') }}" rel="stylesheet" type="text/css" />
    <!-- Font Awesome icons (free version)-->
    <script src="https://use.fontawesome.com/releases/v5.15.3/js/all.js" crossorigin="anonymous"></script>
    <style>
        header.masthead {
            text-align: center;
            color: dodgerblue;
            background-image: url("{{ asset('src/img/yellow.png')}}");
            background-repeat: no-repeat;
            background-attachment: scroll;
            background-position: center center;
            background-size: cover;
            padding-top: 8rem;
            padding-bottom: 9rem;
            margin-top: 150px;
            text-shadow: 1px 1px darkblue;
        }
        .h1 a {
            color: #007bff;
            text-shadow: none;
        }
        .h1 a:hover {
            text-shadow: 1px 1px darkblue;
            color: dodgerblue;
         }
        .toggle {
            -webkit-box-shadow: 0 2px 8px rgba(0, 0, 0, 0.6);
            -moz-box-shadow: 0 2px 8px rgba(0, 0, 0, 0.6);
            box-shadow: 0 2px 8px rgba(0, 0, 0, 0.6);
            margin: -24px;
            position: absolute;
            bottom: 11.6%;
            left: 50%;
            z-index: 1045;
        }
        .toggle.i .cross {
            -webkit-transform: rotateZ(0deg);
            -moz-transform: rotateZ(0deg);
            transform: rotateZ(0deg); }
        .toggle.i .cross .x {
            margin-left: -2px;
            width: 4px;
            margin-top: -12px; }
        .toggle.i .cross .y {
            margin-top: -4px;
            height: 16px; }

        .cross {
            -webkit-transform: rotateZ(45deg);
            -moz-transform: rotateZ(45deg);
            transform: rotateZ(45deg);
            position: absolute;
            left: 50%;
            top: 50%; }
        .cross .x, .cross .y {
            -webkit-border-radius: 2px;
            -moz-border-radius: 2px;
            border-radius: 2px;
            -webkit-background-clip: padding-box;
            -moz-background-clip: padding-box;
            background-clip: padding-box;
            background-color: #1D1F27;
            height: 4px;
            width: 4px;
            margin: -2px;
            position: absolute;
            left: 0;
            top: 0; }
        .cross .x {
            margin-left: -12px;
            margin-top: -2px;
            width: 24px; }
        .cross .y {
            margin-top: -12px;
            height: 24px; }

        .toggle-left {
            transform: rotateZ(-90deg);
        }
        .toggle-right {
            transform: rotateZ(90deg);
        }
        button {
            -webkit-font-smoothing: antialiased;
            -webkit-border-radius: 24px;
            -moz-border-radius: 24px;
            border-radius: 24px;
            -webkit-background-clip: padding-box;
            -moz-background-clip: padding-box;
            background-clip: padding-box;
            font-size: 1.33333em;
            line-height: 45.6px;
            font-family: "Dosis", sans-serif;
            background-color: #F2F2F2;
            font-weight: 600;
            height: 48px;
            width: 48px;
            position: relative;
            display: block;
            margin: 0 auto;
            outline: none;
            border: none; }
        button.hide {
            opacity: 0; }
    </style>
{% endblock %}

{% block content %}
    <nav class="navbar navbar-expand-lg navbar-light fixed-top" id="mainNav">
        <div class="container">
            <div class="col-md-1 d-none d-sm-none d-md-block">
                <a href="{{ path('installation_show', {title: '25-01-2023'}) }}" title="Игра со случайными числами">
                    <button class="toggle-i toggle i toggle-left" style="position: inherit">
                        <div class="cross">
                            <div class="x"></div>
                            <div class="y"></div>
                        </div>
                    </button>
                </a>
            </div>
            <div class="col-md-10 col-12 text-center">
{#                <a class="navbar-brand js-scroll-trigger" href="{{ path('homepage') }}">#}
{#                    <span class="notranslate" translate="no">{{ "The «METLUG» Theatre - means we're from Lugansk City"|raw }}</span>#}
{#                </a>#}
            </div>
            <div class="col-md-1 d-none d-sm-none d-md-block">
                <a href="#" title="">
                    <button class="toggle-i toggle i toggle-right" style="position: inherit">
                        <div class="cross">
                            <div class="x"></div>
                            <div class="y"></div>
                        </div>
                    </button>
                </a>
            </div>
        </div>
    </nav>

    <!-- Header -->
    <header class="masthead">
        <div class="container">
            <div class="row">
                <div class="col-sm-12 col-12">
                    <div class="h1">8 февраля 2023 год. <br>
                    С 28-летним юбилеем! <br>
                        <a href="#" data-toggle="modal" data-target="#exampleModalLong">МЭТЛУГ СЕГОДНЯ</a></div>
                </div>
                <div class="col-8"></div>
                <div class="col-2">
                    <img src="{{ asset('build/img/logo_2.png') }}" alt="" style="width: 90px; position: absolute; margin-top: 1rem">
                </div>
            </div>
        </div>
    </header>
    <!-- Header -->
    <button style="position: fixed" id="toggle" class="toggle-i toggle i" data-toggle="modal" data-target="#commandModal" title="Добавить комментарий">
        <div class="cross">
            <div class="x"></div>
            <div class="y"></div>
        </div>
    </button>

    <!-- Modal -->
    <div class="modal fade" id="exampleModalLong" tabindex="-1" role="dialog" aria-labelledby="exampleModalLongTitle" aria-hidden="true">
        <div class="modal-dialog modal-lg" role="document">
            <div class="modal-content">
                <div class="modal-header">
                    <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                        <span aria-hidden="true">&times;</span>
                    </button>
                </div>
                <div class="modal-body">
                    {% include 'esse.html.twig' %}
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-dismiss="modal">Close</button>
                </div>
            </div>
        </div>
    </div>
    <!-- Modal -->
    <div class="modal fade" id="commandModal" tabindex="-1" role="dialog" aria-labelledby="commandModalTitle" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered" role="document">
            <div class="modal-content" style="text-shadow: none">
                <div class="modal-header text-muted text-left">
                    <p></p>
                </div>
                            {% if app.user %}
                                {{ form_start(form) }}
                                <div class="modal-header text-muted">
                                    <h5 class="modal-title" id="exampleModalLongTitle">{{ app.user }}</h5>
                                </div>
                                <div class="modal-body">
                                    <div class="d-none">{{ form_row(form.username) }}</div>
                                    {{ form_row(form.text) }}

                                    <div class="d-none" style="font-size: 20px">{{ form_row(form.mediaLink) }}</div>
                                    <div class="d-none">{{ form_row(form.type) }}</div>
                                </div>
                                <div class="modal-footer">
                                    <div class="col-6 pr-0">

                                    </div>
                                    <div class="col-6 pl-0 pr-0">
                                        <button type="submit" class="col-12 btn btn-secondary" style="height: auto">Оставить Комментарий</button>
                                    </div>
                                </div>
                                {{ form_end(form) }}
                            {% else %}
                                {{ form_start(form) }}
                                <div class="modal-body" >
                                    {{ form_widget(form.username) }}
                                    <hr>
                                    <div class="">{{ form_row(form.text) }}</div>
                                    <div class="custom-file d-none">
                                        {{ form_row(form.mediaLink) }}
                                    </div>
                                    <div   class="d-none" style="font-size: 20px">{{ form_row(form.type) }}</div>
                                </div>
                                <div class="modal-footer">
                                    <div class="col-6 pr-0">
                                        <a class="btn btn-primary" href="{{ path('connect_google_start') }}"><i class="fab fa-google"></i><span style="margin-left: 15px;font-weight: bold;">Bойти в Google</span></a>
                                    </div>
                                    <div class="col-6 pl-0 pr-0">
                                        <button type="submit" class="col-12 btn btn-secondary" style="height: auto">Оставить Комментарий</button>
                                    </div>
                                </div>
                                {{ form_end(form) }}
                            {% endif %}
                <div class="col-md-12 col-sm-12">
                    <div class="comments-list">
                        {% for comment in comments %}
                            {% if comment.user %}
                                {% set avatar = comment.user.avatar %}
                                {% set user = comment.user %}
                            {% else %}
                                {% set avatar = asset('src/img/logo.jpg') %}
                                {% set user = comment.username %}
                            {% endif %}
                            <div class="col-sm-12 text-muted">
                                <div class="media">
                                    <div class="media-body text-left">
                                        <h4 class="media-heading user_name"><img style="width: 40px" class="rounded-circle" src="{{ avatar }}" alt=""> {{ user }}</h4>
                                        {{ comment.text|raw }}
                                        {% if comment.type == 'video' %}
                                            <div class="embed-responsive embed-responsive-16by9">
                                                <iframe class="embed-responsive-item" src="{{ comment.mediaLink }}" frameborder="0" allow="accelerometer; encrypted-media; gyroscope; picture-in-picture" allowfullscreen></iframe>
                                            </div>
                                        {% endif %}
                                        {% if comment.type == 'audio' %}
                                            <audio  controlsList="nodownload" controls style="z-index: 150;width: 100%">
                                                <source src="{{ comment.mediaLink }}" type="audio/mpeg">
                                                Your browser does not support the audio element.
                                            </audio>
                                        {% endif %}
                                        {% if comment.type == 'image' and comment.mediaLink %}
                                            <div class="col-12" >
                                                <img width="300px" height="300px" src="{{ comment.mediaLink }}" alt="{{ installation.description }}">
                                            </div>
                                        {% endif %}
                                    </div>
                                    <div class="text-right">
                                        <p><small>{{ comment.createdAt|date('Y-m-d H:i') }}</small></p>
                                    </div>
                                </div>
                            </div>
                        {% endfor %}
                    </div>
                    <div class="modal-footer">
                        <div class="col-12 pr-0 text-center">
                            <a href="#" class="close" style="display: contents" data-dismiss="modal" aria-label="Close">
                                <i class="fa fa-times" style="color: red"></i>
                            </a>
                        </div>
                    </div>

                </div>
            </div>
        </div>
    </div>
{% endblock %}

{% block javascripts %}
    {{ parent() }}

    <!-- Contact form JavaScript -->
    <script src="{{ asset('build/js/jqBootstrapValidation.js') }}"></script>
    <script src="{{ asset('build/js/contact_me.js') }}"></script>
    <script>
        {% if modalShow is defined and modalShow is not null %}
        $('#commandModal').modal('show')
        {% endif %}
    </script>
    <!-- Bootstrap core JS-->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.0.1/dist/js/bootstrap.bundle.min.js"></script>
{% endblock %}
