{% extends 'layout.html.twig' %}
{% block title %}День памяти Сергея Курёхина.{% endblock %}
{% block stylesheets %}
    {{ parent() }}
    <link href="{{ asset('build/css/32-05-2020.css') }}" rel="stylesheet" type="text/css" />
    <style>
        /*
 * Base structure
 */
        /* indie-flower-regular - latin */
        @import url('https://fonts.googleapis.com/css2?family=Montserrat+Alternates:ital,wght@1,600;1,700&family=Cormorant+Infant:ital,wght@1,600&family=Bellota:ital,wght@1,700&family=Balsamiq+Sans:ital,wght@0,400;0,700;1,400;1,700&family=Ruslan+Display&family=Caveat:wght@400;700&family=Marck+Script&family=Neucha&display=swap');
        h2 {
            font-family: 'Kaushan Script', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, 'Helvetica Neue', Arial, sans-serif, 'Apple Color Emoji', 'Segoe UI Emoji', 'Segoe UI Symbol', 'Noto Color Emoji';
        }

        header.masthead {
            text-align: center;
            color: yellow;
            background-image: url("{{ asset('src/img/blue.png')}}");
            background-repeat: no-repeat;
            background-attachment: scroll;
            background-position: center center;
            background-size: cover;
            padding-top: 8rem;
            padding-bottom: 5.5rem;
            margin-top: 25px;
        }
        header.masthead2 {
            text-align: center;
            color: dodgerblue;
            background-image: url("{{ asset('src/img/yellow.png')}}");
            background-repeat: no-repeat;
            background-attachment: scroll;
            background-position: center center;
            background-size: cover;
            padding-top: 5.5rem;
            padding-bottom: 8rem;
        }
        #icon-sound {
            position: fixed;
            top: 5px;
            right: 20px;
            color: #fed136;
            background-color: #000;
            padding: 11px 14px;
            border-radius: 50%;
            box-shadow: 0 2px 4px rgba(0,0,0,.25);
            z-index: 2000;
            opacity: .85;
        }
        #icon-sound:hover {
            color: #fed136;
            background-color: white;
        }

    </style>
    <link href="{{ asset('build/css/slick.css') }}" rel="stylesheet" type="text/css" />
    <link href="{{ asset('build/css/slick-theme.css') }}" rel="stylesheet" type="text/css" />
{% endblock %}

{% block content %}
{#    <div id="icon-sound" class="d-none">#}
{#        <i class="fas fa-volume-up"></i>#}
{#    </div>#}

    <img src="{{ asset('src/img/hart.gif') }}" alt="" style="margin-top: 100px; width: 400px">
    <!-- Header -->
    <header class="masthead">
        <div class="container">
            <div class="row">
                <div class="col-sm-12 col-12">
                    <h2>А ВЫСОЦКОМУ исполнилось бы  ВОСЕМЬДЕСЯТ ПЯТЬ</h2>
                </div>
            </div>
        </div>
    </header>
    <!-- Header -->
    <header class="masthead2">
        <div class="container">
            <div class="row">
                <div class="col-sm-12 col-12">
                    <h3>Двадцать пятое января две тысячи двадцать третьего года</h3>
                </div>
                <div class="col-1">
                    <img src="{{ asset('build/img/logo_2.png') }}" alt="" style="width: 90px; position: absolute; margin-top: 1rem">
                </div>
            </div>
        </div>
    </header>
{% endblock %}

{% block javascripts %}
    {{ parent() }}
    <script src="{{ asset('build/js/slick.min.js') }}"></script>
{% endblock %}
