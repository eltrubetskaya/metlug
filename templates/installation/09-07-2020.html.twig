{% extends 'layout.html.twig' %}

{% block stylesheets %}
    {{ parent() }}
    <link href="{{ asset('build/css/32-05-2020.css') }}" rel="stylesheet" type="text/css" />
{% endblock %}

{% block content %}
    <div id="icon-plus" data-toggle="modal" data-target="#commandModal">
        <i class="fas fa-plus fa-2x"></i>
    </div>
    <!-- Header -->
    <div class="container-fluid">
        <div class="row">
            <div class="col-12"style="height: 100px"></div>
        </div>
        <div class="row">
            <div class="col-6">
                <div id="carouselIndicators" class="carousel slide" data-ride="carousel">
                    <ol class="carousel-indicators">
                        <li data-target="#carouselIndicators" data-slide-to="0" class="active"></li>
                        <li data-target="#carouselIndicators" data-slide-to="1" class=""></li>
                        <li data-target="#carouselIndicators" data-slide-to="2" class=""></li>
                        <li data-target="#carouselIndicators" data-slide-to="3" class=""></li>
                    </ol>
                    <div class="carousel-inner">
                        <div class="carousel-item active">
                            <img class="d-block w-100" data-src="{{ asset('build/img/sparrow_3.jpg') }}" alt="First slide" src="{{ asset('build/img/sparrow_3.jpg') }}" data-holder-rendered="true">
                        </div>
                        <div class="carousel-item">
                            <img class="d-block w-100" data-src="{{ asset('build/img/sparrow.jpg') }}" alt="Second slide" src="{{ asset('build/img/sparrow.jpg') }}" data-holder-rendered="true">
                        </div>
                        <div class="carousel-item">
                            <img class="d-block w-100" data-src="{{ asset('build/img/leto.jpg') }}" alt="Third slide" src="{{ asset('build/img/leto.jpg') }}" data-holder-rendered="true">
                        </div>
                        <div class="carousel-item">
                            <img class="d-block w-100" data-src="{{ asset('build/img/sparrow_2.jpg') }}" alt="Third slide" src="{{ asset('build/img/sparrow_2.jpg') }}" data-holder-rendered="true">
                        </div>
                    </div>
                    <a class="carousel-control-prev" href="#carouselIndicators" role="button" data-slide="prev">
                        <span class="carousel-control-prev-icon" aria-hidden="true"></span>
                        <span class="sr-only">Previous</span>
                    </a>
                    <a class="carousel-control-next" href="#carouselIndicators" role="button" data-slide="next">
                        <span class="carousel-control-next-icon" aria-hidden="true"></span>
                        <span class="sr-only">Next</span>
                    </a>
                </div>
            </div>
            <div class="col-6">
                <div id="carouselExampleIndicators" class="carousel slide" data-ride="carousel">
                    <ol class="carousel-indicators">
                        <li data-target="#carouselExampleIndicators" data-slide-to="0" class="active"></li>
                        <li data-target="#carouselExampleIndicators" data-slide-to="1" class=""></li>
                        <li data-target="#carouselExampleIndicators" data-slide-to="2" class=""></li>
                    </ol>
                    <div class="carousel-inner">
                        <div class="carousel-item active">
                            <img class="d-block w-100" data-src="{{ asset('build/img/R-2.jpg') }}" alt="First slide" src="{{ asset('build/img/R-2.jpg') }}" data-holder-rendered="true">
                        </div>
                        <div class="carousel-item">
                            <img class="d-block w-100" data-src="{{ asset('build/img/R-3.jpg') }}" alt="Second slide" src="{{ asset('build/img/R-3.jpg') }}" data-holder-rendered="true">
                        </div>
                        <div class="carousel-item">
                            <img class="d-block w-100" data-src="{{ asset('build/img/R-1.jpg') }}" alt="Third slide" src="{{ asset('build/img/R-1.jpg') }}" data-holder-rendered="true">
                        </div>
                    </div>
                    <a class="carousel-control-prev" href="#carouselExampleIndicators" role="button" data-slide="prev">
                        <span class="carousel-control-prev-icon" aria-hidden="true"></span>
                        <span class="sr-only">Previous</span>
                    </a>
                    <a class="carousel-control-next" href="#carouselExampleIndicators" role="button" data-slide="next">
                        <span class="carousel-control-next-icon" aria-hidden="true"></span>
                        <span class="sr-only">Next</span>
                    </a>
                </div>
            </div>
        </div>
    </div>

    {{ render(controller('App\\Controller\\CommentController::new', {'installationId': installation.id})) }}
{% endblock %}

{% block javascripts %}
    {{ parent() }}

    <script>
        $('.carousel').carousel()
        if ({{ modalShow }}) {
            $('#commandModal').modal('show')
        }
        document.getElementById("playAudio").volume = 0.1;
    </script>
{% endblock %}
