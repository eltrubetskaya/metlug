                            <iframe class="embed-responsive-item" src="https://www.youtube-nocookie.com/embed/nTlwf3Dvufk?showinfo=1&modestbranding=1&rel=0&fs=1&iv_load_policy=3" allow="accelerometer; autoplay; encrypted-media; gyroscope; picture-in-picture" allowfullscreen></iframe>
                        </div>
                    </div>
                </div>
                <div class="col-md-6 col-sm-12">
