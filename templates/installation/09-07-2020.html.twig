{% block javascripts %}
    {{ parent() }}
    <script src="{{ asset('build/js/slick.min.js') }}"></script>

    <script>
        {% if modalShow is defined and modalShow is not null %}
            $('#commandModal').modal('show')
        {% endif %}
        $('.carousel').carousel()
        $('.slider-center').slick({
            dots: true,
            infinite: true,
            speed: 300,
            slidesToShow: 1,
            centerMode: true,
            variableWidth: true,
            slidesToScroll: 1,
            autoplay: true,
            autoplaySpeed: 2000,
        });

    </script>
{% endblock %}
