{% block javascripts %}
    {{ parent() }}
    <script src="{{ asset('build/js/slick.min.js') }}"></script>

    <script>
        {% if modalShow is defined and modalShow is not null %}
            $('#commandModal').modal('show')
        {% endif %}
        $('.carousel').carousel()
        $('.slider-center').slick({
            dots: true,
            infinite: true,
            speed: 300,
            slidesToShow: 1,
            centerMode: true,
            variableWidth: true,
            slidesToScroll: 1,
            autoplay: true,
            autoplaySpeed: 2000,
        });
        let zima = document.getElementById("playAudio_zima")
        let vesna = document.getElementById("playAudio_vesna")
        let leto = document.getElementById("playAudio_leto")
        let osen = document.getElementById("playAudio_osen")

        function playAudioZima() {
            pauseAudioVesna()
            pauseAudioLeto()
            pauseAudioOsen()
            zima.play()
        }
        function pauseAudioZima() {
            zima.pause()
        }

        function playAudioVesna() {
            pauseAudioZima()
            pauseAudioLeto()
            pauseAudioOsen()
            vesna.play()
        }
        function pauseAudioVesna() {
            vesna.pause()
        }

        function playAudioLeto() {
            pauseAudioZima()
            pauseAudioVesna()
            pauseAudioOsen()
            leto.play()
        }
        function pauseAudioLeto() {
            leto.pause()
        }

        function playAudioOsen() {
            pauseAudioZima()
            pauseAudioLeto()
            pauseAudioVesna()
            osen.play()
        }
        function pauseAudioOsen() {
            osen.pause()
        }
        $('.link-audio').on('click', function () {
            pauseAudioOsen()
            pauseAudioZima()
            pauseAudioLeto()
            pauseAudioVesna()
        })
    </script>
{% endblock %}
