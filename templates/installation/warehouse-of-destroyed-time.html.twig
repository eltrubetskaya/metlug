{% extends 'layout.html.twig' %}
{% block title %}{{ installation.description }}{% endblock %}
{% block stylesheets %}
    {{ parent() }}
    <link href="{{ asset('build/css/30-09-2020.css') }}" rel="stylesheet" type="text/css" />
{% endblock %}

{% block menu %}
    <!-- Navigation -->
    <nav class="navbar navbar-expand-lg navbar-dark fixed-top" style="opacity: 0" id="mainNav">
        <div class="container-fluid">
            <div class="col-1 d-none d-sm-none d-md-block">
                <a href="{{ path('installation_show', {title: '23-08-2020'}) }}" title="Александр Грин. Фантазийное видение.">
                    <button class="toggle-i toggle i toggle-left">
                        <div class="cross">
                            <div class="x"></div>
                            <div class="y"></div>
                        </div>
                    </button>
                </a>
            </div>
            <div class="col-md-10 col-12 pl-0 text-center">
                <a class="navbar-brand js-scroll-trigger" href="{{ path('homepage') }}" title="The «METLUG» Theatre - means we're from Lugansk City">The «METLUG» Theatre - means we're from Lugansk City</a>
            </div>
            <div class="col-1 d-none d-sm-none d-md-block">
                <a href="{{ path('installation_show', {title: '15-10-2020'}) }}" title="Фридрих Ницше">
                    <button class="toggle i toggle-right">
                        <div class="cross">
                            <div class="x"></div>
                            <div class="y"></div>
                        </div>
                    </button>
                </a>
            </div>
        </div>
    </nav>
{% endblock %}

{% block content %}

    <div class="container">
        <div class="row">
            <div class="wrapper col-12" style="opacity: 0">
                <p class="title mt-35">{{ installation.description }}</p>

                <div class="clip-text clip-text_ten"><a href="#">Жил был лист бумаги. И он был формата «A четыре». Получен путем последовательного деления формата «A ноль». Был он в пачке с остальными листами</a></div>
            </div>
        </div>
        <div class="row">
            <div class="col-12">
                <div id="warehouse" class="col-lg-6 col-8" style="display: none; position: absolute;margin-top: 15%;">
                    <div class="embed-responsive embed-responsive-16by9">
                        <iframe class="embed-responsive-item" src="https://www.youtube-nocookie.com/embed/ZNKmyqZ3oPI?showinfo=1&modestbranding=1&rel=0&fs=1&iv_load_policy=3" frameborder="0" allow="accelerometer; encrypted-media; gyroscope; picture-in-picture" allowfullscreen></iframe>
                    </div>
                </div>
                <img id="bg" src="{{ asset('src/img/poster1.png') }}">
                <img id="bg-puzzle" src="{{ asset('src/img/poster2.gif') }}">
            </div>
        </div>
    </div>
{% endblock %}
{% block footer %}
