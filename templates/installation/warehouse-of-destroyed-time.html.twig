{% extends 'layout.html.twig' %}
{% block title %}{{ installation.description }}{% endblock %}
{% block stylesheets %}
    {{ parent() }}
    <link href="{{ asset('build/css/23-08-2020.css') }}" rel="stylesheet" type="text/css" />
    <link href="{{ asset('build/css/main.css') }}" rel="stylesheet" type="text/css" />
{% endblock %}

{% block menu %}
    <!-- Navigation -->
    <nav class="navbar navbar-expand-lg navbar-dark fixed-top" id="mainNav">
        <div class="container-fluid">
            <div class="col-1 d-none d-sm-none d-md-block">
                <a href="{{ path('installation_show', {title: '23-08-2020'}) }}" title="Александр Грин. Фантазийное видение.">
                    <button class="toggle-i toggle i toggle-left">
                        <div class="cross">
                            <div class="x"></div>
                            <div class="y"></div>
                        </div>
                    </button>
                </a>
            </div>
            <div class="col-md-10 col-12 pl-0">
                <a class="navbar-brand js-scroll-trigger" href="{{ path('homepage') }}">The «METLUG» Theatre - means we're from Lugansk City</a>
            </div>
            <div class="col-1 d-none d-sm-none d-md-block">
                <a href="#" title="What is next?">
                    <button class="toggle i toggle-right">
                        <div class="cross">
                            <div class="x"></div>
                            <div class="y"></div>
                        </div>
                    </button>
                </a>
            </div>
        </div>
    </nav>
{% endblock %}

{% block content %}

    <div class="container-fluid" style="text-align: center">
        <div class="panel" style="display: inline-block">
            <img src="{{ asset('build/img/wood_texture_fence_knothole_old_wood_texture_wooden_wooden_texture-554367.jpg') }}">
        </div>
    </div>
{% endblock %}
{% block footer %}{% endblock footer %}

{% block javascripts %}
<script src="{{ asset('build/js/jquery.min.js') }}"></script>
<script src="{{ asset('build/js/jquery.image-jigsaw.min.js') }}"></script>
{#<script>#}
{#    {% if modalShow is defined and modalShow is not null %}#}
{#    $('#commandModal').modal('show')#}
{#    {% endif %}#}
{#</script>#}
<script>
    $(document).ready(function() {
        $(".panel").jigsaw({freq: 2000, x: 4, y:4, margin: 2, callbacks: [{event: 'mouseover', func: function() {
                    $(this).data('last_bg', $(this).css('background-image'));
                    $(this).css('background-image', 'none');
                }}, {event: 'mouseout', func: function() {
                    $(this).css('background-image', $(this).data('last_bg'));
                }}]});
    });
    </script>
{% endblock javascripts %}
