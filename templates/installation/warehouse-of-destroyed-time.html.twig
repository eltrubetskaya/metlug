                <div class="col-md-12 col-sm-12">
                    <div class="comments-list">
                        {% for comment in comments %}
                            {% if comment.user %}
                                {% set avatar = comment.user.avatar %}
                                {% set user = comment.user %}
                            {% else %}
                                {% set avatar = asset('src/img/logo.jpg') %}
                                {% set user = comment.username %}
                            {% endif %}
                            <div class="col-sm-12 text-muted">
                                <div class="media">
                                    <div class="media-body text-left">
                                        <h4 class="media-heading user_name">
                                            <img style="width: 40px" class="rounded-circle" src="{{ avatar }}" alt=""> {{ user }}
                                        </h4>
                                        <div class="text-left">
                                            <h6><small>{{ comment.createdAt|date('Y-m-d H:i') }}</small></h6>
                                        </div>
                                        {% if comment.type == 'audio' %}
                                            <audio  controlsList="nodownload" controls style="z-index: 150;width: 100%">
                                                <source src="{{ comment.mediaLink }}" type="audio/mpeg">
                                                Your browser does not support the audio element.
                                            </audio>
                                        {% endif %}
                                        {% if comment.type == 'video' %}
                                            <div class="embed-responsive embed-responsive-16by9">
                                                <iframe class="embed-responsive-item" src="https://www.youtube-nocookie.com/embed/{{ comment.mediaLink }}?showinfo=1&modestbranding=1&rel=0&fs=1&iv_load_policy=3" frameborder="0" allow="accelerometer; encrypted-media; gyroscope; picture-in-picture" allowfullscreen></iframe>
                                            </div>
                                        {% endif %}
                                        {% if comment.type == 'image' %}
                                            <div class="col-12" >
                                                <img width="300px" height="300px" style="background-image: url({{ comment.mediaLink }}); background-repeat: no-repeat; background-size: 270px 270px;" src="{{ asset('src/img/puzzle_1.png') }}" alt="{{ installation.description }}">
                                            </div>

                                        {% endif %}
                                    </div>
                                </div>
                            </div>
                        {% endfor %}
                    </div>
                </div>
            </div>
        </div>
    </div>

    <button id="toggle" class="toggle-i toggle i" data-toggle="modal" data-target="#commandModal" title="Добавить комментарий" style="opacity: 0">
        <div class="cross">
            <div class="x"></div>
            <div class="y"></div>
        </div>
    </button>
{% endblock footer %}

{% block javascripts %}
    {{ parent() }}
<script>
    {% if modalShow is defined and modalShow is not null %}
        $('#commandModal').modal('show')
    {% endif %}
</script>
<script>
    let close = true;
    function startup() {
        window.addEventListener('scroll', function() {
            bodyScroll()
        })
        window.addEventListener('click', function() {
            bodyScroll()
        })
        window.addEventListener('touchstart', function() {
            bodyScroll()
        })
        window.addEventListener('touchmove', function() {
            bodyScroll()
        })
    }

    document.addEventListener("DOMContentLoaded", startup);
    $(document).ready(function() {
        $('#comment_text').text('puzzle')
        $('#bg').animate(
            {
                opacity: 1
            }, 6000
        )
    });
    function bodyScroll() {
        if (close) {
            $('#bg').css('display', 'none')
            $('#bg-puzzle').css('display', 'block')
            setTimeout(function () {
                $('#warehouse').fadeIn(6000)
                $('#toggle, .wrapper, .navbar').animate(
                    {
                        opacity: 1
                    }, 6000
                )
            }, 3000)
            close = false
        }
    }
    </script>
{% endblock javascripts %}
