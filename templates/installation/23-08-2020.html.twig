                                                </audio>
                                            {% endif %}
                                            {% if comment.type == 'video' %}
                                                <div class="embed-responsive embed-responsive-16by9">
                                                    <iframe class="embed-responsive-item" src="https://www.youtube-nocookie.com/embed/{{ comment.mediaLink }}?showinfo=1&modestbranding=1&rel=0&fs=1&iv_load_policy=3" frameborder="0" allow="accelerometer; encrypted-media; gyroscope; picture-in-picture" allowfullscreen></iframe>
                                                </div>
                                            {% endif %}
                                        </div>
                                        <div class="text-right">
                                            <p><small>{{ comment.createdAt|date('Y-m-d H:i') }}</small></p>
                                            {% if comment.installation.category is not null and comment.installation.category.title == '32-may'%}
                                                <div>
                                                    <img width="40px" src="{{ asset('build/img/dandelion_PNG12853.png') }}" alt="">
                                                </div>
                                            {% endif %}
                                        </div>
                                    </div>
                                </div>
                            {% endfor %}
                        </div>
                    </div>
                    <ul class="links">
                        <li style="width: 100%">
                            <a style="cursor: pointer" onclick="hideDetails()" title="Close">
                                <i class="fa fa-times"></i>
                            </a>
                        </li>
                    </ul>
                </div>
            </div>
        </div>
    </div>
{% endblock %}

{% block footer %}{% endblock footer %}

{% block javascripts %}

    <!-- Scripts -->
    <script src="{{ asset('build/js/libraries.min.js') }}"></script>
    <script src="{{ asset('build/js/jquery.parallax.js') }}"></script>
    <script>
        hideImg();
        function showImg() {
            $('.ship img').show(500)
        }
        function hideImg() {
            $('.ship img').hide(500)
        }
        window.onload = function() {
            //preload mouse down image here via Image()
            $(".ship").bind('touchstart', function(){
                $('.ship img').show(500)
            }).bind('touchend', function(){
                $('.ship img').hide(500)
            });
        }
        // jQuery Selections
        var $html = $('html'),
            $container = $('#container'),
            $toggle = $('#toggle'),
            $about = $('#about'),
            $scene = $('#scene');

        // Hide browser menu.
        (function() {
            setTimeout(function(){window.scrollTo(0,0);},0);
        })();

        // Setup FastClick.
        FastClick.attach(document.body);

        // Add touch functionality.
        if (Hammer.HAS_TOUCHEVENTS) {
            $container.hammer({drag_lock_to_axis: true});
            _.tap($html, 'a,button,[data-tap]');
        }

        // Add touch or mouse class to html element.
        $html.addClass(Hammer.HAS_TOUCHEVENTS ? 'touch' : 'mouse');

        // Resize handler.
        (resize = function() {
            $scene[0].style.width = window.innerWidth + 'px';
            $scene[0].style.height = window.innerHeight + 'px';
        })();

        // Attach window listeners.
        window.onresize = _.debounce(resize, 200);
        window.onscroll = _.debounce(resize, 200);

        function showDetails() {
            $about.removeClass('d-none');
            setTimeout(function () {
                $about.removeClass('hide');
                $toggle.removeClass('i');
            }, 100)
        }

        function hideDetails() {
            setTimeout(function () {
                $about.addClass('d-none');
            }, 500)
            $about.addClass('hide');
            $toggle.addClass('i');
        }

        function showDetailsCloud(cloudSection) {
            $cloud = $(cloudSection)
            $cloud.removeClass('d-none');
            setTimeout(function () {
                $cloud.removeClass('hide');
            }, 100)
        }

        function hideDetailsCloud(cloudSection) {
            $cloud = $(cloudSection)
            setTimeout(function () {
                $cloud.addClass('d-none');
            }, 500)
            $cloud.addClass('hide');
            $iframe = $(cloudSection + ' iframe');
            $iframe.attr("src", $iframe.attr("src"));
        }

        {% if modalShow is defined and modalShow is not null %}
            showDetails()
        {% endif %}
        // Listen for toggle click event.
        $toggle.on('click', function(event) {
            $toggle.hasClass('i') ? showDetails() : hideDetails();
        });

        // Pretty simple huh?
        $scene.parallax();
        $('#add-comment').on('click', function () {
            $('.add-comment').click()
        })
        var wrapper = document.querySelector('.marquee-wrapper'),
            marquee = document.querySelector('.marquee'),
            wrapperWidth = wrapper.offsetWidth,
            marqueeWidth = marquee.scrollWidth;

        document.querySelector('button').onclick = function() {
            clearInterval(interval)
        }

        function move() {
            var currentTX = getComputedStyle(marquee).transform.split(',');
            if( currentTX[4] === undefined ) {
                currentTX = -1;
            } else {
                currentTX = parseFloat(currentTX[4]) - 1;
            }

            if(-currentTX >= marqueeWidth) {
                marquee.style.transform = 'translateX(' + wrapperWidth + 'px)';

            } else {
                marquee.style.transform = 'translateX(' + currentTX + 'px)';
            }
        }

        var interval = setInterval(move, 10);
    </script>

{% endblock %}
