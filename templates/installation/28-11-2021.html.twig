                    </a>
                </li>
            </ul>
    </div>
</nav>
<section class="container-fluid">

    <div class="col-lg-12 text-right">
        <img  style="transform: scale(1, -1); position: relative; left: -25px" class="text-center" src="{{ asset('src/img/train2.png') }}" alt="">

        <img id="train2" src="{{ asset('src/img/train.png') }}" alt="" style="
        right: -500px;
        position: relative;
       -moz-transform: scale(-1, -1);
    -o-transform: scale(-1, -1);
    -webkit-transform: scale(-1, -1);
    transform: scale(-1, -1);">
    </div>
    <div class="col-xs-2"></div>
    <div class="col-xs-12 text-center">
        <div class="embed-responsive embed-responsive-16by9">
            <iframe class="embed-responsive-item" src="https://www.youtube-nocookie.com/embed/PcOpfGbb4D4?showinfo=1&modestbranding=1&rel=0&fs=1&iv_load_policy=3" frameborder="0" allow="accelerometer; encrypted-media; gyroscope; picture-in-picture" allowfullscreen></iframe>
        </div>
    </div>
    <div class="col-xs-12">
        <img id="train" style="position: relative;" src="{{ asset('src/img/train.png') }}" alt="">
        <img  class="text-center" src="{{ asset('src/img/train2.png') }}" alt="" style="
        position: relative;left: -25px">
    </div>
</section>
<!-- Footer-->
{#<footer class="footer bg-black small text-center text-white-50">#}
{#    <div class="container px-4 px-lg-5"> &copy; МЭТЛУГ 1995-{{"now"|date("Y")}}</div>#}
{#</footer>#}

<button style="position: fixed" id="toggle" class="toggle-i toggle i" data-toggle="modal" data-target="#commandModal" title="Добавить комментарий">
    <div class="cross">
        <div class="x"></div>
        <div class="y"></div>
    </div>
</button>
<!-- Modal -->
<div class="modal fade" id="commandModal" tabindex="-1" role="dialog" aria-labelledby="commandModalTitle" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered" role="document">
        <div class="modal-content" style="text-shadow: none">
            <div class="modal-header text-muted text-left">
{#                <h4 style="font-size: 17px; color: #fff">Станьте участником этой инсталляции! <br>В качестве комментария оставьте пожалуйста строчку из Высоцкого - первую что прийдет в голову.</h4>#}
            </div>
            {% if app.user %}
                {{ form_start(form) }}
                <div class="modal-header text-muted">
                    <h5 class="modal-title" id="exampleModalLongTitle">{{ app.user }}</h5>
                </div>
                <div class="modal-body">
                    <div class="hidden">{{ form_row(form.username) }}</div>
                    {{ form_row(form.text) }}

                    <div class="hidden" style="font-size: 20px">{{ form_row(form.mediaLink) }}</div>
                    <div class="hidden">{{ form_row(form.type) }}</div>
                </div>
                <div class="modal-footer">
                    <div class="col-xs-6 pr-0">

                    </div>
                    <div class="col-xs-6 pl-0 pr-0">
                        <button type="submit" class="col-xs-12 btn btn-primary" style="height: auto">Оставить Комментарий</button>
                    </div>
                </div>
                {{ form_end(form) }}
            {% else %}
                {{ form_start(form) }}
                <div class="modal-body" >
                    {{ form_widget(form.username) }}
                    <hr>
                    <div class="">{{ form_row(form.text) }}</div>
                    <div class="custom-file hidden">
                        {{ form_row(form.mediaLink) }}
                    </div>
                    <div   class="hidden" style="font-size: 20px">{{ form_row(form.type) }}</div>
                </div>
                <div class="modal-footer">
                    <div class="col-xs-6 pr-0 text-center">
                        <a class="btn btn-primary" href="{{ path('connect_google_start') }}"><i class="fab fa-google"></i><span style="margin-left: 15px;font-weight: bold;">Bойти в Google</span></a>
                    </div>
                    <div class="col-xs-6 pl-0 pr-0">
                        <button type="submit" class="col-xs-12 btn btn-primary" style="height: auto">Оставить Комментарий</button>
                    </div>
                </div>
                {{ form_end(form) }}
            {% endif %}
            <div class="col-md-12 col-sm-12">
                <div class="comments-list">
                    {% for comment in comments %}
                        {% if comment.user %}
                            {% set avatar = comment.user.avatar %}
                            {% set user = comment.user %}
                        {% else %}
                            {% set avatar = asset('src/img/logo.jpg') %}
                            {% set user = comment.username %}
                        {% endif %}
                        <div class="col-sm-12 text-muted">
                            <div class="media">
                                <div class="media-body text-left" style="color: #fff;font-size: 17px;">
                                    <h4 class="media-heading user_name"><img style="width: 40px" class="rounded-circle" src="{{ avatar }}" alt=""> {{ user }}</h4>
                                    {{ comment.text|raw }}
                                    {% if comment.type == 'video' %}
                                        <div class="embed-responsive embed-responsive-16by9">
                                            <iframe class="embed-responsive-item" src="{{ comment.mediaLink }}" frameborder="0" allow="accelerometer; encrypted-media; gyroscope; picture-in-picture" allowfullscreen></iframe>
                                        </div>
                                    {% endif %}
                                    {% if comment.type == 'audio' %}
                                        <audio  controlsList="nodownload" controls style="z-index: 150;width: 100%">
                                            <source src="{{ comment.mediaLink }}" type="audio/mpeg">
                                            Your browser does not support the audio element.
                                        </audio>
                                    {% endif %}
                                    {% if comment.type == 'image' and comment.mediaLink %}
                                        <div class="col-xs-12" >
                                            <img width="300px" height="300px" src="{{ comment.mediaLink }}" alt="{{ installation.description }}">
                                        </div>
                                    {% endif %}
                                </div>
                                <div class="text-right">
                                    <p><small>{{ comment.createdAt|date('Y-m-d H:i') }}</small></p>
                                </div>
                            </div>
                        </div>
                    {% endfor %}
                </div>

            </div>
            <div class="modal-footer">
                <div class="col-xs-12 pr-0 text-center">
                    <a href="#" class="close" style="display: contents" data-dismiss="modal" aria-label="Close">
                        <i class="fa fa-times" style="color: red"></i>
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>

