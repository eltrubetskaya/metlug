{% extends 'layout.html.twig' %}
{% block title %}{{ installation.description }}{% endblock %}
{% block stylesheets %}
    <link rel="stylesheet" type="text/css" href="{{ asset('build/css/scrollpath.css') }}" />
    <link href="https://fonts.googleapis.com/css?family=Terminal+Dosis&subset=latin" rel="stylesheet" type="text/css">
    <script type="text/javascript" src="{{ asset('build/js/prefixfree.min.js') }}"></script>
    {{ parent() }}
    <link rel="stylesheet" type="text/css" href="{{ asset('build/css/06-11-2020.css') }}" />
    <link rel="stylesheet" href="{{ asset('build/css/jquery.fancybox.min.css') }}">
{% endblock %}


{% block menu %}
    <div class="overlay"></div>
    <!-- Navigation -->
    <nav class="navbar navbar-expand-lg navbar-dark pb-0" id="mainNav">
        <div class="container-fluid">
            <div class="col-1 d-none d-sm-none d-md-block">
                <a href="{{ path('installation_show', {title: '15-10-2020'}) }}" title="Фридрих Ницше">
                    <button class="toggle-i toggle i toggle-left">
                        <div class="cross">
                            <div class="x"></div>
                            <div class="y"></div>
                        </div>
                    </button>
                </a>
            </div>
            <div class="col-md-10 col-12">
                <a class="navbar-brand js-scroll-trigger" href="{{ path('homepage') }}">
                    <span class="notranslate" translate="no">{{ "The «METLUG» Theatre - means we're from Lugansk City"|raw }}</span>
                </a>
            </div>
            <div class="col-1 d-none d-sm-none d-md-block">
                <a href="#" title="">
                    <button class="toggle i toggle-right">
                        <div class="cross">
                            <div class="x"></div>
                            <div class="y"></div>
                        </div>
                    </button>
                </a>
            </div>
        </div>
    </nav>
{% endblock %}

