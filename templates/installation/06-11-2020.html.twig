{% extends 'layout.html.twig' %}
{% block title %}{{ installation.description }}{% endblock %}
{% block stylesheets %}
    <link rel="stylesheet" type="text/css" href="{{ asset('build/css/scrollpath.css') }}" />
    <link href="https://fonts.googleapis.com/css?family=Terminal+Dosis&subset=latin" rel="stylesheet" type="text/css">
    <script type="text/javascript" src="{{ asset('build/js/prefixfree.min.js') }}"></script>
    {{ parent() }}
    <link rel="stylesheet" type="text/css" href="{{ asset('build/css/06-11-2020.css') }}" />
{% endblock %}


{% block menu %}
    <div class="overlay"></div>
    <!-- Navigation -->
    <nav class="navbar navbar-expand-lg navbar-dark pb-0" id="mainNav">
        <div class="container-fluid">
            <div class="col-1 d-none d-sm-none d-md-block">
                <a href="{{ path('installation_show', {title: '15-10-2020'}) }}" title="Фридрих Ницше">
                    <button class="toggle-i toggle i toggle-left">
                        <div class="cross">
                            <div class="x"></div>
                            <div class="y"></div>
                        </div>
                    </button>
                </a>
            </div>
            <div class="col-md-10 col-12">
                <a class="navbar-brand js-scroll-trigger" href="{{ path('homepage') }}">
                    <span class="notranslate" translate="no">{{ "The «METLUG» Theatre - means we're from Lugansk City"|raw }}</span>
                </a>
            </div>
            <div class="col-1 d-none d-sm-none d-md-block">
                <a href="#" title="">
                    <button class="toggle i toggle-right">
                        <div class="cross">
                            <div class="x"></div>
                            <div class="y"></div>
                        </div>
                    </button>
                </a>
            </div>
        </div>
    </nav>
{% endblock %}

{% block content %}
{#    <div class="container" style="margin-top: 100px">#}
{#        <div class="row">#}
{#            <div class="col-12 text-center">#}
{#                <img src="{{ asset('src/img/sokolov1.jpg') }}" alt="">#}
{#                <h3>Саша Соколов</h3>#}
{#                <p>	6 ноября 1943</p>#}
{#            </div>#}
{#        </div>#}
{#    </div>#}
    <nav>
        <ul>
            <li><a href="#start">1</a></li>
            <li><a href="#description">2</a></li>
            <li><a href="#syntax">3</a></li>
            <li><a href="#scrollbar">4</a></li>
            <li><a href="#rotations">5</a></li>
            <li><a href="#rotations-rotated">6</a></li>
            <li><a href="#source">7</a></li>
            <li><a href="#follow">8</a></li>
        </ul>
    </nav>
    <div class="wrapper">
        <div class="demo">
            <h1>Саша Соколов</h1>
            <span class="arrow">&darr;</span> Школа для дураков <span class="arrow">&darr;</span>
        </div>

        <div class="description">
            <span class="big">Преврати дождь в град, день – в ночь, хлеб наш насущный дай нам днесь, гласный звук сделай шипящим</span>
        </div>

        <div class="syntax">
            <span class="big">Очень красивая. Почти красивая. Почти некрасивая, мечтающая о полевых цветах.</span>
        </div>

        <div class="scrollbar">
            <span class="big">Люд, шедший мимо, был щупл, зябл, приезж..</span>
        </div>

        <div class="rotations">
            <span class="big">Но вот на поляну являются косари. Их инструменты, их двенадцатиручные косы,</span>
            <span class="upside-down big">тоже блестят на солнце, но не золотом, как у музыкантов, а серебром, И косари начинают косить.</span>
        </div>

        <div class="source">
				<span class="big">Жить и пошло, и вредно. Однако смерть - не выход.<span>
                    </span>
                </span>
        </div>

        <div class="follow">
            <span class="big">Хитер. Хитер и робок народ мой перед сыном его.</span>
        </div>
    </div>

{% endblock %}
{% block footer %}
    
{% endblock %}

{% block javascripts %}
    {{ parent() }}
    <script>
        {% if modalShow is defined and modalShow is not null %}
        $('#commandModal').modal('show')
        {% endif %}
    </script>
    <script type="text/javascript" src="https://code.jquery.com/jquery-latest.pack.js"></script>
    <script type="text/javascript" src="{{ asset('build/js/jquery.easing.1.3.js') }}"></script>
    <script type="text/javascript" src="{{ asset('build/js/jquery.scrollpath.js') }}"></script>
    <script type="text/javascript" src="{{ asset('build/js/demo.js') }}"></script>
{% endblock %}
