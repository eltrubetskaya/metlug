{% extends 'layout.html.twig' %}
{% block title %}{{ installation.description }}{% endblock %}
{% block stylesheets %}
    {{ parent() }}
{% endblock %}


{% block menu %}
    <!-- Navigation -->
    <nav class="navbar navbar-expand-lg navbar-dark fixed-top" id="mainNav">
        <div class="container-fluid">
            <div class="col-1 d-none d-sm-none d-md-block">
                <a href="{{ path('installation_show', {title: '15-10-2020'}) }}" title="Фридрих Ницше">
                    <button class="toggle-i toggle i toggle-left">
                        <div class="cross">
                            <div class="x"></div>
                            <div class="y"></div>
                        </div>
                    </button>
                </a>
            </div>
            <div class="col-md-10 col-12 pl-0 text-center">
                <a class="navbar-brand js-scroll-trigger" href="{{ path('homepage') }}">
                    <span class="notranslate" translate="no">{{ "The «METLUG» Theatre - means we're from Lugansk City"|raw }}</span>
                </a>
            </div>
            <div class="col-1 d-none d-sm-none d-md-block">
                <a href="№" title="">
                    <button class="toggle i toggle-right">
                        <div class="cross">
                            <div class="x"></div>
                            <div class="y"></div>
                        </div>
                    </button>
                </a>
            </div>
        </div>
    </nav>
{% endblock %}

{% block content %}
    <div class="container" style="margin-top: 100px">
        <div class="row">
            <div class="col-12 text-center">
                <img src="{{ asset('src/img/sokolov1.jpg') }}" alt="">
                <h3>Саша Соколов</h3>
                <p>	6 ноября 1943</p>
            </div>
        </div>
    </div>

{% endblock %}

{% block javascripts %}
    {{ parent() }}
    <script>
        {% if modalShow is defined and modalShow is not null %}
        $('#commandModal').modal('show')
        {% endif %}
    </script>
{% endblock %}
