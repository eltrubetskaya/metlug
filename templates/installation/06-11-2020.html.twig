                        </nav>
{% endblock %}

{% block javascripts %}
    {{ parent() }}
    <script>
        {% if modalShow is defined and modalShow is not null %}
        $('#commandModal').modal('show')
        {% endif %}
    </script>
    <script type="text/javascript" src="https://code.jquery.com/jquery-latest.pack.js"></script>
    <script type="text/javascript" src="{{ asset('build/js/jquery.easing.1.3.js') }}"></script>
    <script type="text/javascript" src="{{ asset('build/js/jquery.scrollpath.js') }}"></script>
    <script type="text/javascript" src="{{ asset('build/js/demo.js') }}"></script>
