<!DOCTYPE html>
<html lang="en">
<head>
    <!-- Global site tag (gtag.js) - Google Analytics -->
    <script async src="https://www.googletagmanager.com/gtag/js?id={{ ga_tracking }}"></script>
    <script>
        window.dataLayer = window.dataLayer || [];
        function gtag(){dataLayer.push(arguments);}
        gtag('js', new Date());

        gtag('config', '{{ ga_tracking }}');
    </script>

    <meta charset="UTF-8" />
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <meta name="viewport" content="width=device-width, initial-scale=1, shrink-to-fit=no">
    <meta name="description" content="Молодёжный эмоциональный театр">
    <meta name="author" content="">
    <title>{% block title %}The "METLUG" Theatre - means we're from Lugansk City{% endblock %}</title>

    <meta property="og:site_name" content="The «METLUG» Theatre"/>
    <meta property="og:title" content="The «METLUG» Theatre - means we're from Lugansk City"/>
    <meta property="og:url" content="https://theatre-metlug.org/"/>
    <meta property="og:type" content="website"/>
    <meta property="og:description" content="Молодёжный эмоциональный театр"/>

    {% block stylesheets %}
        <!-- Bootstrap core CSS -->
        <link href="{{ asset('build/css/bootstrap.min.css') }}" rel="stylesheet">

        <!-- Custom fonts for this template -->
        <link href="{{ asset('build/css/all.min.css') }}" rel="stylesheet" type="text/css">
        <link href="https://fonts.googleapis.com/css?family=Montserrat:400,700" rel="stylesheet" type="text/css">
        <link href='https://fonts.googleapis.com/css?family=Kaushan+Script' rel='stylesheet' type='text/css'>
        <link href='https://fonts.googleapis.com/css?family=Droid+Serif:400,700,400italic,700italic' rel='stylesheet' type='text/css'>
        <link href='https://fonts.googleapis.com/css?family=Roboto+Slab:400,100,300,700' rel='stylesheet' type='text/css'>

        <link rel="stylesheet" href="https://pro.fontawesome.com/releases/v5.12.0/css/all.css" integrity="sha384-ekOryaXPbeCpWQNxMwSWVvQ0+1VrStoPJq54shlYhR8HzQgig1v5fas6YgOqLoKz" crossorigin="anonymous">
        <!-- Custom styles for this template -->
        <link href="{{ asset('build/css/agency.css') }}" rel="stylesheet">
    {% endblock %}
    <link rel="shortcut icon" href="{{ asset('build/img/logo_2.png') }}" type="image/x-icon">

    {% block javascriptstop %}{% endblock %}
</head>
<body id="page-top">
{% block menu %}{% endblock %}

{% block body %}{% endblock %}
{% block javascripts %}
    <!-- Bootstrap core JavaScript -->
    <script src="{{ asset('build/js/node-libs.js') }}"></script>

    <!-- Contact form JavaScript -->
    <script src="{{ asset('build/js/jqBootstrapValidation.js') }}"></script>
    <script src="{{ asset('build/js/contact_me.js') }}"></script>

    <!-- Custom scripts for this template -->
    <script src="{{ asset('build/js/agency.min.js') }}"></script>
{% endblock %}
</body>
</html>
